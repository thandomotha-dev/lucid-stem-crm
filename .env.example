# Postgres connection (any host: local, managed, container)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lucidstem"

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts stored email-provider OAuth tokens. Losing it means every mailbox must be re-connected.
ENCRYPTION_KEY=""

# Used only by `npm run db:seed` to create the first organisation + owner
SEED_ORG_NAME="Lucid Stem"
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
